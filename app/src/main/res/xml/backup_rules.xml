<?xml version="1.0" encoding="utf-8"?>
<!--
   Copia de seguridad en Android 11 o anterior.
   La sesión (cookie sessionid, válida un año, y csrftoken) y las cookies del WebView no viajan a
   la copia: quien la restaurase entraría en la cuenta sin contraseña. Tras restaurar basta con
   volver a iniciar sesión; los ajustes sí se conservan.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/session_prefs.preferences_pb" />
    <exclude domain="root" path="app_webview/" />
</full-backup-content>

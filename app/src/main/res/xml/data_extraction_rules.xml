<?xml version="1.0" encoding="utf-8"?>
<!--
   Copia de seguridad y traspaso entre dispositivos en Android 12 o posterior.
   Mismas exclusiones que backup_rules.xml: la sesión y las cookies del WebView se quedan fuera.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session_prefs.preferences_pb" />
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session_prefs.preferences_pb" />
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>

# F-Droid & Security (¡Nunca subir claves de firma ni ficheros de configuración sensibles!)
*.jks
*.keystore
signing.properties
google-services.json
fabric.properties

# Archivos de configuración local (rutas del SDK de Android, etc.)
local.properties
.env
cookies.txt

# Gradle
.gradle/
build/
*/build/
gradle-app.setting

# Excepciones para Gradle Wrapper (Obligatorio en F-Droid para poder compilar)
!gradle/wrapper/gradle-wrapper.jar
!gradle-wrapper.jar
!gradle-wrapper.properties

# Android Studio / IntelliJ IDEA / VS Code
.idea/
*.iml
*.iws
*.ipr
.vscode/

# SO y otros
.DS_Store
*.DS_Store
Thumbs.db

# Binarios y compilados (F-Droid NO permite binarios pre-compilados en el repo)
*.class
*.apk
*.aab
*.ap_
*.dex
*.obf
*.orig
*.so
*.jar
*.aar
*.tmp
*.log

# C/C++ y NDK
obj/
.cxx/
.externalNativeBuild/

# Entornos y cachés de Python (para los scripts locales)
venv/
.venv/
__pycache__/
*.pyc

# Kotlin daemon
.kotlin/

# Archivos de prueba y scripts temporales locales
scratch*.kt
scratch*.py
test_*.py
test_*.kt
test_*.sh
*.html
inbox.json

# Scripts de utilidades locales (no necesarios para F-Droid)
update_strings.py
add_strings.py
translate.py
get_quotes.py
translate_clear_notifs.py
login.py

# Archivos temporales de releases locales
app/release/baselineProfiles/*/app-release.dm
app/release/output-metadata.json
